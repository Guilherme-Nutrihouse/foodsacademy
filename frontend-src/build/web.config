<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Mantem chamadas /api no backend Node/Express rodando localmente na porta 5000. -->
        <rule name="ReverseProxyInboundRule1" stopProcessing="true">
          <match url="^api/(.*)" />
          <conditions>
            <add input="{CACHE_URL}" pattern="^(https?)://" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:5000/api/{R:1}" />
        </rule>

        <!-- Encaminha videos locais ao backend quando nao existe arquivo direto no IIS. -->
        <rule name="VideosCursosBackend" stopProcessing="true">
          <match url="^videos_cursos/(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{CACHE_URL}" pattern="^(https?)://" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:5000/videos_cursos/{R:1}" />
        </rule>

        <!-- Encaminha icones locais ao backend quando nao existe arquivo direto no IIS. -->
        <rule name="IconsCursosBackend" stopProcessing="true">
          <match url="^icons_cursos/(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{CACHE_URL}" pattern="^(https?)://" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:5000/icons_cursos/{R:1}" />
        </rule>

        <!--
          Fallback da SPA React.
          Quando a URL digitada no navegador nao e arquivo nem pasta real,
          o IIS entrega o index.html para o React Router decidir a tela.
          Isso evita 404 em rotas como /home, /video/4 e /materiais/4.
        -->
        <rule name="ReactSpaFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Garante que a raiz do site abra o app React. -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Evita que navegadores reutilizem um index.html antigo com referencia a bundles antigos. -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
